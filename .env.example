# Local development
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
REACT_APP_PUBLIC_SITE_URL=http://localhost:3000
REACT_APP_SEO_ALLOW_INDEXING=false

# Production hosting configuration (set this in the deployment environment
# after api.fyaa.io is attached to the Render service and HTTPS is active):
# REACT_APP_API_BASE_URL=https://api.fyaa.io/api/v1
# REACT_APP_PUBLIC_SITE_URL=https://trip.fyaa.io
# Keep false while the current domain is temporary. Enable only after the
# final canonical domain is live and verified.
# REACT_APP_SEO_ALLOW_INDEXING=false
